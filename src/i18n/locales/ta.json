  "bhavas": {
    "1": "முதல் பாவம் (தனு பாவம் - உடல், தோற்றம் மற்றும் குணம்)",
    "2": "இரண்டாம் பாவம் (தன பாவம் - செல்வம், குடும்பம் மற்றும் வாக்கு)",
    "3": "மூன்றாம் பாவம் (சகஜ பாவம் - தைரியம், முயற்சி மற்றும் இளைய சகோதரர்)",
    "4": "நான்காம் பாவம் (சுக பாவம் - தாய், கல்வி, வீடு மற்றும் வாகனம்)",
    "5": "ஐந்தாம் பாவம் (புத்திர பாவம் - புத்தி, புண்ணியம் மற்றும் குழந்தைகள்)",
    "6": "ஆறாம் பாவம் (அரி பாவம் - கடன், நோய் மற்றும் எதிரி)",
    "7": "ஏழாம் பாவம் (களத்திர பாவம் - திருமணம், வாழ்க்கைத்துணை மற்றும் கூட்டுத்தொழில்)",
    "8": "எட்டாம் பாவம் (ஆயுள் பாவம் - ஆயுள், விபத்து மற்றும் மறைமுக ஞானம்)",
    "9": "ஒன்பதாம் பாவம் (பாக்கிய பாவம் - பாக்கியம், தந்தை மற்றும் ஆன்மீகம்)",
    "10": "பத்தாம் பாவம் (கர்ம பாவம் - தொழில், அந்தஸ்து மற்றும் புகழ்)",
    "11": "பதினொன்றாம் பாவம் (லாப பாவம் - லாபம், வருமானம் மற்றும் மூத்த சகோதரர்)",
    "12": "பன்னிரண்டாம் பாவம் (விரய பாவம் - செலவு, வெளிநாட்டு பயணம் மற்றும் மோட்சம்)"
  },
