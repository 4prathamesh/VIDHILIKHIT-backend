    "3": "ತೃತೀಯ ಭಾವ (ಸಹಜ ಭಾವ - ಧೈರ್ಯ, ಸೋದರರು ಮತ್ತು ಪರಿಶ್ರಮ)",
    "4": "ಚತುರ್ಥ ಭಾವ (ಸುಖ ಭಾವ - ತಾಯಿ, ಸುಖ, ಆಸ್ತಿ ಮತ್ತು ವಾಹನ)",
    "5": "ಪಂಚಮ ಭಾವ (ಪುತ್ರ ಭಾವ - ಬುದ್ಧಿವಂತಿಕೆ, ಸಂತಾನ ಮತ್ತು ಪುಣ್ಯ)",
    "6": "ಷಷ್ಠ ಭಾವ (ಅರಿ ಭಾವ - ರೋಗ, ಸಾಲ ಮತ್ತು ಶತ್ರುಗಳು)",
    "7": "ಸಪ್ತಮ ಭಾವ (ಕಳತ್ರ ಭಾವ - ವಿವಾಹ, ಸಂಗಾತಿ ಮತ್ತು ಪಾಲುದಾರಿಕೆ)",
    "8": "ಅಷ್ಟಮ ಭಾವ (ಆಯುಷ್ಯ ಭಾವ - ಆಯುಷ್ಯ ಮತ್ತು ರಹಸ್ಯ ವಿದ್ಯೆ)",
    "9": "ನವಮ ಭಾವ (ಭಾಗ್ಯ ಭಾವ - ಅದೃಷ್ಟ, ಧರ್ಮ ಮತ್ತು ಗುರು)",
    "10": "ದಶಮ ಭಾವ (ಕರ್ಮ ಭಾವ - ವೃತ್ತಿ, ಅಧಿಕಾರ ಮತ್ತು ಕೀರ್ತಿ)",
    "11": "ಏಕಾದಶ ಭಾವ (ಲಾಭ ಭಾವ - ಲಾಭ, ಆದಾಯ ಮತ್ತು ಮಿತ್ರರು)",
