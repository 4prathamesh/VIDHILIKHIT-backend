    {
      "name": "1. Account Creation (Registration)",
      "item": [
        {
          "name": "Register - Exact Time of Birth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('authToken', jsonData.data.token);",
                  "    pm.environment.set('userId', jsonData.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"mobileNumber\": \"+919876543210\",\n  \"password\": \"SecurePassword123!\",\n  \"termsAccepted\": true,\n  \"birthDetails\": {\n    \"dob\": \"1995-08-25\",\n    \"tobChoice\": \"exact\",\n    \"tobTime\": \"14:30:00\",\n    \"gender\": \"male\",\n    \"pob\": \"Pune, Maharashtra, India\"\n  }\n}"
