    {
      "name": "3. Password Recovery",
      "item": [
        {
          "name": "Forgot Password - Initiate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.devDebug) {",
                  "        pm.environment.set('resetToken', jsonData.data.devDebug.rawToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
