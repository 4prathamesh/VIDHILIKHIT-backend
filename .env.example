# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vidhilikhit_db

# JWT & Authentication Configuration
JWT_SECRET=super_secret_jwt_key_vidhilikhit_2026_change_in_production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Password Reset Configuration
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60
APP_FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/google/callback

# S3 / CDN Storage for Generated Reports & Avatars (Optional)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vidhilikhit-reports-bucket
CDN_BASE_URL=https://cdn.vidhilikhit.com
